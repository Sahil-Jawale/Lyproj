# PrescriptAI — environment variables
# Copy to .env and fill in.  .env is gitignored; never commit a real key.
#
#   cp .env.example .env
#   # then edit .env and paste your key

# ── Required: the VLM reader (S1) ────────────────────────────────────
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional: cost control (docs/ARCHITECTURE_V2.md §14) ─────────────
# Hard ceiling in USD for the whole testing phase. The spend guard refuses
# any call that would push cumulative spend past this. Default 30.
PRESCRIPTAI_SPEND_CAP=30

# ── Backend ──────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./prescriptai.db
SECRET_KEY=change-me-in-production

# ── Frontend ─────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
