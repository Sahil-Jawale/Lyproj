# PrescriptAI — environment variables
# Copy to .env and fill in.  .env is gitignored; never commit a real key.
#
#   cp .env.example .env
#   # then edit .env and paste your key

# ── Required: the VLM reader (S1) ────────────────────────────────────
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional: cost control (docs/ARCHITECTURE_V2.md §14) ─────────────
# Hard ceiling in USD for the whole testing phase. The spend guard refuses
# any call that would push cumulative spend past this. Default 30.
PRESCRIPTAI_SPEND_CAP=30

# ── Backend ──────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./prescriptai.db
# Keys the HMAC on verification/reset/recovery codes. Use a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it invalidates every outstanding code.
SECRET_KEY=change-me-in-production

# ── Auth: sessions (backend/auth/) ───────────────────────────────────
# Session ends after this long without a request...
SESSION_IDLE_MINUTES=60
# ...or this long after sign-in, whichever comes first.
SESSION_MAX_HOURS=12
# true whenever the site is served over HTTPS. false only for http://localhost.
COOKIE_SECURE=false
# Browser origins allowed to call the API with the session cookie.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Auth: delivering codes ───────────────────────────────────────────
# Without SMTP_HOST, email codes are PRINTED IN THE BACKEND CONSOLE (dev only).
# Phone/SMS codes are always printed there — no SMS provider is wired in yet.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@yourdomain.in

# ── Frontend ─────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
